{
	"name": "otoclaw",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"packageManager": "bun@1.4.0",
	"scripts": {
		"dev": "bun run --filter '@otoclaw/daemon' dev",
		"build": "bun run --filter '*' build",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"test": "bun test",
		"typecheck": "bun run --filter '*' typecheck"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@types/bun": "^1.4.0",
		"typescript": "^7.0.2"
	}
}
